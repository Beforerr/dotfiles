import? 'scripts/languages.just'
import? 'scripts/github.just'

[private]
default:
    just --list --justfile ~/justfile

update: update-config sync-projects

update-config:
    -chezmoi update

update-pkgs:
    -cargo install garden-tools
    -curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
    -cargo binstall --strategies crate-meta-data jj-cli typst-cli

sync: sync-projects sync-overleaf

sync-projects:
    #!/usr/bin/env bash
    for cfg in ~/.config/garden/{garden,JuliaSpacePhysics}.yaml; do
        garden -c "$cfg" grow "*"
        garden -c "$cfg" cmd "*" pull -j4
        garden -c "$cfg" cmd "*" status
    done

# Upload local gog OAuth client + refresh tokens to Bitwarden item "gog"; other machines pull on `chezmoi apply`.
# First run, or rotating the client: `just gog-push ~/Downloads/client_secret_*.json`.
gog-push client="":
    #!/usr/bin/env bash
    set -euo pipefail
    : "${BW_SESSION:?run: export BW_SESSION=\$(bw unlock --raw)}"
    bw sync >/dev/null
    id=$(bw get item gog 2>/dev/null | jq -r .id || true)
    if [ -n "{{client}}" ]; then c=$(jq -c . "{{client}}"); else c=$(bw get notes gog | jq -c .client); fi
    d=$(mktemp -d); trap 'rm -rf "$d"' EXIT
    for e in $(gog auth list --plain | cut -f1); do gog auth tokens export "$e" --out "$d/$e.json" 2>/dev/null; done
    note=$(jq -n --argjson c "$c" '{client: $c, tokens: [inputs | del(.access_token, .access_token_expires_at)]}' "$d"/*.json)
    if [ -n "$id" ]; then
        bw get item "$id" | jq --arg n "$note" '.notes = $n' | bw encode | bw edit item "$id" >/dev/null
    else
        bw get template item | jq --arg n "$note" '.type = 2 | .secureNote = {type: 0} | .name = "gog" | .notes = $n | .login = null' | bw encode | bw create item >/dev/null
    fi
    echo "pushed $(jq '.tokens | length' <<<"$note") accounts"

[private]
sync-overleaf:
    cd ~/projects/share && just sync-overleaf

backup-config:
    #!/usr/bin/env sh
    mackup backup --force

[private]
backup-pictures:
    rclone sync ~/Pictures BoxUCLA:Pictures --progress

# restoring the configuration using mackup
restore-config:
    #!/usr/bin/env sh
    echo "Syncing applications with 'mackup'..."
    mackup restore --force

[private]
link:
    ln -s ~/.claude/CLAUDE.md ~/.codex/AGENTS.md
    ln -s ~/Library/CloudStorage/Box-Box/research ~/research

[private]
migrate:
    rclone sync GoogleDriveUCLA:library BoxUCLA:library --progress
    ln -s "/Volumes/My Passport for Mac/data" ~/data

clean:
    -brew cleanup
    -pixi clean cache --yes

[private]
disk-usage:
    gdu-go --ignore-dirs-pattern '.*CloudStorage'
    gdu-go / -I '.*CloudStorage'

# extract_figures from a PDF file
extract_figures +pdf_file:
    ~/scripts/extract_figures.py {{ pdf_file }}
