#!/usr/bin/env zsh
# Dirty jj repos under $1 (default ~/src/JuliaSpacePhysics); --json for widgets.
# Read-only: --ignore-working-copy + git status, so it never snapshots jj
# working copies that agents are mid-edit in.
export PATH=$HOME/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH
export GIT_OPTIONAL_LOCKS=0
json=0; [[ $1 == --json ]] && { json=1; shift }
root=${1:-$HOME/src/JuliaSpacePhysics}
cd $root || exit 1
for d in */(N); do d=${d%/}; [[ -d $d/.jj ]] || continue
  files=$(git -C $d status --porcelain)
  [[ -n $files ]] || continue
  desc=$(jj -R $d --ignore-working-copy log -r @ --no-graph -T 'coalesce(description.first_line(), "(no desc)")')
  op=$(jj -R $d --ignore-working-copy op log -n1 --no-graph -T 'time.end().format("%s") ++ "\t" ++ time.end().ago()')
  IFS=$'\t' read -r opt ago <<< $op
  if (( json )); then
    jq -cn --arg repo $d --arg path $root/$d --arg desc $desc --argjson opt $opt \
      --arg ago $ago --arg files $files \
      '{repo:$repo, path:$path, desc:$desc, opt:$opt, ago:$ago, files:($files|split("\n"))}'
  else
    printf "%-28s %3s files  @ %-45.45s | %s\n" $d ${#${(f)files}} $desc $ago
  fi
done | if (( json )); then jq -cs .; else cat; fi
