typeset -U path fpath

path=(
  "$HOME/.bun/bin"
  "$HOME/.pixi/bin"
  "$HOME/.codeium/windsurf/bin"
  "$HOME/.juliaup/bin"
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  "$HOME/.julia/bin"
  $path
)
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# disable homebrew auto update
export HOMEBREW_NO_INSTALL_UPGRADE=1

export PERSON_PROFILE_DIR="$HOME/Library/CloudStorage/Box-Box/profiles"

export GOG_ACCOUNT=zzj956959688@gmail.com

# bun
export BUN_INSTALL="$HOME/.bun"

export PATH

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY AUTO_CD

_zsh_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $_zsh_cache ]] || mkdir -p "$_zsh_cache"

_fresh24() { local -a f=( $1(N.mh-24) ); (( $#f )) }

if [[ -o interactive && -t 1 ]]; then
  # compaudit dominated startup. -C skips but trusts dumps and rebuilds daily.
  # -d to avoid writing new .zcompdump.<host>.<pid> per run.
  autoload -Uz compinit
  _zdump="${ZDOTDIR:-$HOME}/.zcompdump"
  if _fresh24 $_zdump; then compinit -C -d "$_zdump"; else compinit -d "$_zdump"; fi

  _cache_eval() {
    local f="$_zsh_cache/$1.zsh" bin
    bin=$(command -v "$1" 2>/dev/null) || return
    [[ -f $f && $f -nt $bin ]] || "${@:2}" >| "$f" 2>/dev/null
    source "$f"
  }
  _cache_eval jj jj util completion zsh
  _cache_eval juliaup juliaup completions zsh
  _cache_eval fzf fzf --zsh
  _cache_eval atuin atuin init zsh  # after fzf: both bind ^R
  _cache_eval zoxide zoxide init zsh
  _cache_eval direnv direnv hook zsh
  _cache_eval broot broot --print-shell-function zsh
  _cache_eval starship starship init zsh

  ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
  # Clone can fail at login before the network is up; skip plugins rather than error.
  [[ -d $ZINIT_HOME/.git ]] || git clone --quiet https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
  if [[ -r $ZINIT_HOME/zinit.zsh ]]; then
    source "${ZINIT_HOME}/zinit.zsh"
    zinit wait lucid for \
      OMZL::git.zsh \
      OMZP::git \
      OMZP::aliases \
      hlissner/zsh-autopair \
    atload'_zsh_autosuggest_start' \
      zsh-users/zsh-autosuggestions \
      zdharma-continuum/fast-syntax-highlighting
    zinit cdreplay -q   # compinit ran above
  fi

  for f in $HOME/.config/zsh/plugins/*.zsh(N); do source $f; done
fi

unset _zsh_cache _zdump
unfunction _fresh24 2>/dev/null

