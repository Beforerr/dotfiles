    "cc-plugin-plugin-authoring@builtin": false,
    "cc-plugin-diff@builtin": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "auto",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": false
