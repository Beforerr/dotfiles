  },
  "model": "opus",
  "skillOverrides": {
    "claude-in-chrome": "off",
    "security-review": "off",
    "loop": "off",
    "fewer-permission-prompts": "off",
    "anthropic-skills:my-writing-style": "off",
    "anthropic-skills:setup-writing-style": "off",
    "anthropic-skills:pdf": "off",
    "caveman": "off"
