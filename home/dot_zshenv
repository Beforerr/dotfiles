export JULIA_MAX_NUM_PRECOMPILE_FILES=3
# Opt out of telemetry beacons (Headroom, others honoring the convention)
export DO_NOT_TRACK=1 HEADROOM_UPDATE_CHECK=off
# Pkg app shims otherwise bake the versioned juliaup binary path
export JULIA_APPS_JULIA_CMD=julia
# Bash-like word splitting and unmatched globs for agent one-liners; -c only, so zsh scripts keep zsh semantics.
[[ -n $ZSH_EXECUTION_STRING && ( -n $CLAUDECODE || -n $CODEX_THREAD_ID ) ]] && setopt SH_WORD_SPLIT NO_NOMATCH
