{{- /* Renders empty (skipped) unless the vault is unlocked, so plain `chezmoi apply` never prompts. Re-runs when the token rotates. */ -}}
{{- if env "BW_SESSION" -}}
#!/bin/bash
# token sha: {{ (bitwarden "item" "overleaf-git").login.password | sha256sum }}
printf 'protocol=https\nhost=git.overleaf.com\nusername=git\npassword=%s\n\n' \
    "$(bw get password overleaf-git)" | git credential approve
{{- end }}
