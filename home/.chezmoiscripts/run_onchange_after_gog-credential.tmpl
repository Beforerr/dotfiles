{{- /* Renders empty (skipped) unless the vault is unlocked, so plain `chezmoi apply` never prompts. Re-runs when the bundle changes; `just gog-push` writes it. */ -}}
{{- if env "BW_SESSION" -}}
#!/bin/bash
set -euo pipefail
# bundle sha: {{ (bitwarden "item" "gog").notes | sha256sum }}
note=$(bw get notes gog)
jq .client <<<"$note" | gog auth credentials set - >/dev/null
jq -c '.tokens[]' <<<"$note" | while read -r t; do gog auth tokens import - <<<"$t" >/dev/null; done
{{- end }}
