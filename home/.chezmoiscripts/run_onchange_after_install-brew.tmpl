#!/bin/bash

# Brewfile hash: {{ include "packages/Brewfile" | sha256sum }}
export PATH="/opt/homebrew/bin:$PATH"
if command -v brew &>/dev/null; then
    brew bundle --quiet --no-upgrade --file=packages/Brewfile || true
    # Formulae only: many installed casks are deliberately not in the Brewfile.
    brew bundle cleanup --formula --force --file=packages/Brewfile
    brew autoremove
fi
