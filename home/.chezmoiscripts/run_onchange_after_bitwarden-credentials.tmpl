{{- /* Renders empty (skipped) unless the vault is unlocked, so plain `chezmoi apply` never prompts. Re-runs when either item changes. */ -}}
{{- if env "BW_SESSION" -}}
#!/bin/bash
set -euo pipefail
# overleaf sha: {{ (bitwarden "item" "overleaf-git").login.password | sha256sum }}
# gog sha: {{ (bitwarden "item" "gog").notes | sha256sum }}

printf 'protocol=https\nhost=git.overleaf.com\nusername=git\npassword=%s\n\n' \
    "$(bw get password overleaf-git)" | git credential approve

# Note "gog" = {client: <OAuth client_secret JSON>, tokens: [<`gog auth tokens export` JSON>...]}
gog_note=$(bw get notes gog)
jq .client <<<"$gog_note" | gog auth credentials set - >/dev/null
jq -c '.tokens[]' <<<"$gog_note" | while read -r t; do gog auth tokens import - <<<"$t" >/dev/null; done
{{- end }}
